# ---------------------------------------------------------------------------
# AHN Partnerships
# Copy to .env and fill in. Never commit real values.
# This database is NOT shared with Mercator - keep the two apart.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# Postgres (docker-compose maps 5434 to avoid clashing with Mercator on 5433)
DATABASE_URL=postgresql://partners:partners@localhost:5434/partners?schema=public
DIRECT_URL=postgresql://partners:partners@localhost:5434/partners?schema=public

# 32 random bytes, base64. Generate: openssl rand -base64 32
SESSION_SECRET=ZGV2LW9ubHktcGFydG5lcnMtc2Vzc2lvbi1zZWNyZXQhIQ==

# Sign-in is by magic link, emailed through Resend (https://resend.com).
# Leave RESEND_API_KEY empty locally: links are then printed in the dev server
# log instead of emailed. Production requires it, and EMAIL_FROM must use a
# domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="AHN Partnerships <partners@ahnmedia.com>"

# First admin, created by `pnpm db:seed`. They sign in with a magic link.
SEED_ADMIN_EMAIL=admin@ahnmedia.com
SEED_ADMIN_NAME=AHN Admin
